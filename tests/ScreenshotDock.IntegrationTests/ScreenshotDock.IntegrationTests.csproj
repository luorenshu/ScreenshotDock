<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>../../src/ScreenshotDock.App/app.manifest</ApplicationManifest>
    <!-- WPF owns process DPI awareness; the separate Forms receiver uses the same PMv2 manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/ScreenshotDock.App/ScreenshotDock.App.csproj" /></ItemGroup>
</Project>
