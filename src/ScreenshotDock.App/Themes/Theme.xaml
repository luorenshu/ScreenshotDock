<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Ink" Color="#172B4D" />
  <SolidColorBrush x:Key="Muted" Color="#62728D" />
  <SolidColorBrush x:Key="Accent" Color="#2563EB" />
  <SolidColorBrush x:Key="Soft" Color="#EFF6FF" />
  <SolidColorBrush x:Key="Line" Color="#DCE7F7" />
  <SolidColorBrush x:Key="PageBackground" Color="#F7FAFF" />
  <SolidColorBrush x:Key="SelectionOutline" Color="#176BFF" />
  <SolidColorBrush x:Key="CaptureMask" Color="#82000000" />
  <SolidColorBrush x:Key="CaptureLabel" Color="#EB122B52" />
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{StaticResource Ink}" /></Style>
  <Style x:Key="QuietButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="12,8" />
    <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E7EFFF" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D6E6FF" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource QuietButton}" />
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Background" Value="{StaticResource Accent}" /><Setter Property="Foreground" Value="White" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1D4ED8" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1E40AF" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="11,9" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="14" />
    <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Margin" Value="0,9,0,9" /><Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border x:Name="CheckSurface" Width="16" Height="16" VerticalAlignment="Center" Background="White" BorderBrush="#A7BDD9" BorderThickness="1" CornerRadius="3">
          <Grid><Path x:Name="CheckMark" Data="M3,7 L6,10 12,4" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" /><Rectangle x:Name="MixedMark" Width="8" Height="2" Fill="White" Visibility="Collapsed" /></Grid>
        </Border>
        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource Accent}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource Accent}" /><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource Accent}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource Accent}" /><Setter TargetName="MixedMark" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Separator"><Setter Property="Background" Value="{StaticResource Line}" /><Setter Property="Margin" Value="0,10" /></Style>
</ResourceDictionary>
