<Window x:Class="ScreenshotDock.App.Views.DockWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:ScreenshotDock.App.Controls"
 Title="ScreenshotDock · 截图栏" Width="1000" Height="328" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" Foreground="#EDF4FF" Topmost="True" ShowInTaskbar="False" ShowActivated="False" PreviewMouseWheel="CardsMouseWheel">
 <Window.Resources>
  <SolidColorBrush x:Key="Soft" Color="#254B7A" />
  <Style TargetType="TextBlock">
   <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.9" Color="#0D1E38" /></Setter.Value></Setter>
  </Style>
  <Style x:Key="DockButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#DEEBFF" />
   <Setter Property="Padding" Value="10,6" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#35549AFF" /></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#55549AFF" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource DockButton}" />
  <DrawingBrush x:Key="PhotoMask" Stretch="Fill">
   <DrawingBrush.Drawing><GeometryDrawing Brush="White"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1" RadiusX="0.04" RadiusY="0.06" /></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing>
  </DrawingBrush>
 </Window.Resources>
 <Border x:Name="DockContent" Margin="0,4,0,12">
  <Border.RenderTransform><TranslateTransform x:Name="DropTransform" /></Border.RenderTransform>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="37" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>
   <Border Padding="24,0">
    <Grid>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
      <Ellipse Width="7" Height="7" Fill="#76A9FF" Margin="0,0,10,0" />
      <TextBlock Text="ScreenshotDock" Foreground="#DEEAFF" FontSize="12" FontWeight="SemiBold" />
      <TextBlock x:Name="CountLabel" Text="0 张截图" Foreground="#A6C1E6" FontSize="10" Margin="13,1,0,0" />
     </StackPanel>
     <StackPanel x:Name="DockActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Button x:Name="CaptureButton" Click="CaptureClick" Padding="10,5" Margin="0,0,6,0" ToolTip="立即截图"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" Foreground="#DEEBFF" FontSize="12" Margin="0,0,6,0" /><TextBlock Text="截屏" Foreground="#DEEBFF" FontSize="11" /></StackPanel></Button>
      <Button x:Name="LockButton" Content="&#xE718;" FontFamily="Segoe MDL2 Assets" Click="LockClick" ToolTip="锁定展开" Padding="8,6" />
      <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Click="SettingsClick" ToolTip="设置" Padding="8,6" />
     </StackPanel>
    </Grid>
   </Border>
   <Grid x:Name="HintArea" Grid.RowSpan="2" Height="70" Margin="220,0,220,0" VerticalAlignment="Top" IsHitTestVisible="False">
    <TextBlock x:Name="StatusLabel" Text="单击复制 · 拖拽分享 · 右键更多操作" FontSize="12" Foreground="#E6F0FF" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBlock Text="把刚刚的画面，挂在这里。" Foreground="#E6F0FF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
     <TextBlock x:Name="EmptyHint" Text="按 F1 框选屏幕，截图会出现在这里" Foreground="#BED3F1" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <controls:ClotheslineRope IsHitTestVisible="False" />
    <ScrollViewer x:Name="CardScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" ScrollChanged="CardsScrollChanged">
     <ItemsControl x:Name="Cards">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ClotheslinePanel ViewportWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" ScrollOffset="{Binding HorizontalOffset, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Grid Width="246" Height="208" ToolTip="{Binding Tooltip}">
        <Border x:Name="CardSurface" Width="{Binding PhotoWidth}" Height="{Binding PhotoHeight}" Margin="0,13,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
          Background="#DD17345B" BorderBrush="#8C81B4FF" BorderThickness="2" CornerRadius="11" Padding="3" Cursor="Hand" RenderTransformOrigin="0.5,0"
          PreviewMouseLeftButtonDown="CardMouseDown" PreviewMouseMove="CardMouseMove" PreviewMouseLeftButtonUp="CardMouseUp" Tag="{Binding}">
         <Border.RenderTransform><RotateTransform x:Name="PhotoRotation" Angle="{Binding Tilt}" /></Border.RenderTransform>
         <Border.Effect><DropShadowEffect BlurRadius="13" ShadowDepth="6" Opacity="0.3" Color="#07172D" /></Border.Effect>
         <Border.ContextMenu><ContextMenu Opened="CardMenuOpened" Closed="CardMenuClosed">
          <MenuItem Header="复制图片" Click="CopyMenuClick" /><MenuItem Header="预览大图" Click="PreviewMenuClick" />
          <MenuItem Header="另存为…" Click="SaveMenuClick" /><Separator /><MenuItem Header="移除暂存" Click="DeleteMenuClick" />
         </ContextMenu></Border.ContextMenu>
         <Grid>
          <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" OpacityMask="{StaticResource PhotoMask}" />
          <Button x:Name="DeleteButton" Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="5,0" FontSize="16" Background="#D3153054" Foreground="White" Opacity="0" ToolTip="移除暂存" Click="DeleteCardClick" Tag="{Binding}" />
         </Grid>
        </Border>
        <Border Width="9" Height="24" CornerRadius="3" VerticalAlignment="Top" HorizontalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="2" BorderBrush="#ADC6DAF2" BorderThickness="0.5">
         <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#7B91AE" Offset="0" /><GradientStop Color="#E6F1FF" Offset="0.35" /><GradientStop Color="#AABED8" Offset="0.72" /><GradientStop Color="#637A98" Offset="1" /></LinearGradientBrush></Border.Background>
         <Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="2" Opacity="0.48" Color="#0B1C34" /></Border.Effect>
         <Rectangle Width="1" Fill="#68FFFFFF" Margin="0,3,0,3" />
        </Border>
        <TextBlock x:Name="CardCaption" Text="{Binding SizeText}" Foreground="#B1CBEF" FontSize="10" Margin="{Binding CaptionMargin}" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" />
        <Border x:Name="CopiedBadge" Background="#F017365E" BorderBrush="#3C80B0F5" BorderThickness="1" CornerRadius="12" Padding="11,4" Margin="{Binding CaptionMargin}" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
         <TextBlock Text="✓ 已复制" Foreground="#EDF5FF" FontSize="10" />
        </Border>
       </Grid>
       <DataTemplate.Triggers>
        <Trigger SourceName="CardSurface" Property="IsMouseOver" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="#E04B91FF" /><Setter TargetName="CardSurface" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter><Setter TargetName="DeleteButton" Property="Opacity" Value="1" /><Setter TargetName="CardCaption" Property="Opacity" Value="1" /></Trigger>
        <DataTrigger Binding="{Binding IsCopied}" Value="True"><Setter TargetName="CopiedBadge" Property="Visibility" Value="Visible" /><Setter TargetName="CardCaption" Property="Opacity" Value="0" /></DataTrigger>
       </DataTemplate.Triggers>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </Grid>
   <Button Grid.Row="2" x:Name="ClearButton" Content="清空暂存" FontSize="10" Foreground="#A8C4EC" Padding="7,3" Margin="0,0,17,5" HorizontalAlignment="Right" Click="ClearClick" />
  </Grid>
 </Border>
</Window>
