<Window x:Class="ScreenshotDock.App.Views.ClearConfirmationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="清空暂存" Width="400" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
 Background="{StaticResource PageBackground}">
 <StackPanel Margin="28,24">
  <TextBlock Text="清空暂存图片？" FontSize="21" FontWeight="SemiBold" />
  <TextBlock x:Name="CountLabel" Margin="0,16,0,8" TextWrapping="Wrap" />
  <TextBlock Text="将删除全部暂存图片，此操作无法撤销。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
   <Button x:Name="CancelButton" Content="取消" IsDefault="True" IsCancel="True" Margin="0,0,8,0" Click="CancelClick" />
   <Button x:Name="ConfirmButton" Content="确认清空" Style="{StaticResource PrimaryButton}" Click="ConfirmClick" />
  </StackPanel>
 </StackPanel>
</Window>
