<Window x:Class="ScreenshotDock.App.Views.CaptureWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="clr-namespace:ScreenshotDock.Core.Models;assembly=ScreenshotDock.Core"
 xmlns:capture="clr-namespace:ScreenshotDock.App.Capture"
 Title="ScreenshotDock · 选区" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
 Background="Black" KeyDown="CaptureKeyDown">
 <Window.Resources>
  <Style x:Key="CaptureButton" TargetType="Button">
   <Setter Property="Width" Value="33" /><Setter Property="Height" Value="34" /><Setter Property="Margin" Value="1,0" />
   <Setter Property="Padding" Value="7" /><Setter Property="Foreground" Value="#254B7A" /><Setter Property="Background" Value="Transparent" />
   <Setter Property="Cursor" Value="Hand" /><Setter Property="Focusable" Value="False" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#E7EFFF" /></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#D6E6FF" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ToolIcon" TargetType="Path"><Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="Stroke" Value="#254B7A" /><Setter Property="StrokeThickness" Value="1.5" /><Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="StrokeLineJoin" Value="Round" /></Style>
  <Style x:Key="ToolbarDivider" TargetType="Border"><Setter Property="Width" Value="1" /><Setter Property="Height" Value="20" /><Setter Property="Margin" Value="5,0" /><Setter Property="Background" Value="#DCE7F7" /></Style>
  <Style x:Key="ColorButton" TargetType="Button" BasedOn="{StaticResource CaptureButton}"><Setter Property="Width" Value="22" /><Setter Property="Height" Value="24" /></Style>
  <Style x:Key="TextMoveHandle" TargetType="Thumb">
   <Setter Property="Focusable" Value="False" /><Setter Property="Cursor" Value="{x:Static capture:CaptureCursors.Move}" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
   <EventSetter Event="DragStarted" Handler="TextEditorDragStarted" /><EventSetter Event="DragDelta" Handler="TextEditorDragDelta" /><EventSetter Event="DragCompleted" Handler="TextEditorDragCompleted" />
  </Style>
 </Window.Resources>
 <Grid x:Name="Surface" ClipToBounds="True">
  <Canvas x:Name="EditorOverlay" Cursor="Arrow">
   <Border x:Name="CaptureToolbar" Visibility="Collapsed" Background="#FAFFFFFF" BorderBrush="#A7C8FF" BorderThickness="1" CornerRadius="7" Padding="7,5">
    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" /></Border.Effect>
    <StackPanel>
     <StackPanel Orientation="Horizontal">
      <Button x:Name="SelectToolButton" Style="{StaticResource CaptureButton}" ToolTip="调整选区 (V)" Tag="{x:Static models:CaptureTool.Select}" Click="ToolClick"><Path Style="{StaticResource ToolIcon}" Data="M2,3 L7,3 M3,2 L3,7 M11,3 L16,3 M15,2 L15,7 M3,11 L3,16 M2,15 L7,15 M11,15 L16,15 M15,11 L15,16" /></Button>
      <Button x:Name="RectangleToolButton" Style="{StaticResource CaptureButton}" ToolTip="矩形标注 (R)" Tag="{x:Static models:CaptureTool.Rectangle}" Click="ToolClick"><Path Style="{StaticResource ToolIcon}" Data="M3,4 L15,4 15,14 3,14 Z" /></Button>
      <Button x:Name="EllipseToolButton" Style="{StaticResource CaptureButton}" ToolTip="椭圆标注 (O)" Tag="{x:Static models:CaptureTool.Ellipse}" Click="ToolClick"><Path Style="{StaticResource ToolIcon}" Data="M3,9 A6,5 0 1 0 15,9 A6,5 0 1 0 3,9" /></Button>
      <Button x:Name="ArrowToolButton" Style="{StaticResource CaptureButton}" ToolTip="箭头 (A)" Tag="{x:Static models:CaptureTool.Arrow}" Click="ToolClick"><Path Style="{StaticResource ToolIcon}" Data="M3,15 L15,3 M8,3 L15,3 15,10" /></Button>
      <Button x:Name="PenToolButton" Style="{StaticResource CaptureButton}" ToolTip="画笔 (B)" Tag="{x:Static models:CaptureTool.Pen}" Click="ToolClick"><Path Style="{StaticResource ToolIcon}" Data="M3,13 L5,8 12,1 17,6 10,13 5,15 3,13 M10,3 L15,8" /></Button>
      <Button x:Name="MosaicToolButton" Style="{StaticResource CaptureButton}" ToolTip="框选马赛克 (M) · 拖动移动 · 控制点调整大小" Tag="{x:Static models:CaptureTool.Mosaic}" Click="ToolClick"><Grid Width="16" Height="16" SnapsToDevicePixels="True"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M0,0 L8,0 8,8 0,8 Z M8,8 L16,8 16,16 8,16 Z" /><Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" /></Grid></Button>
      <Button x:Name="TextToolButton" Style="{StaticResource CaptureButton}" ToolTip="文字 (T) · 再次点击文字可编辑" Tag="{x:Static models:CaptureTool.Text}" Click="ToolClick"><TextBlock Text="T" FontSize="19" FontWeight="SemiBold" /></Button>
      <Button x:Name="EraserToolButton" Style="{StaticResource CaptureButton}" ToolTip="移除标注 (E)" Tag="{x:Static models:CaptureTool.Eraser}" Click="ToolClick"><Path Style="{StaticResource ToolIcon}" Data="M2,11 L10,3 16,9 9,16 6,16 Z M7,6 L13,12 M9,16 L17,16" /></Button>
      <Border Style="{StaticResource ToolbarDivider}" />
      <Button x:Name="UndoButton" Style="{StaticResource CaptureButton}" ToolTip="撤销 (Ctrl+Z)" Click="UndoClick"><Path Style="{StaticResource ToolIcon}" Data="M6,4 L2,8 6,12 M2,8 L10,8 C16,8 16,16 10,16" /></Button>
      <Button x:Name="RedoButton" Style="{StaticResource CaptureButton}" ToolTip="重做 (Ctrl+Y)" Click="RedoClick"><Path Style="{StaticResource ToolIcon}" Data="M12,4 L16,8 12,12 M16,8 L8,8 C2,8 2,16 8,16" /></Button>
      <Border Style="{StaticResource ToolbarDivider}" />
      <Button x:Name="PinCaptureButton" Style="{StaticResource CaptureButton}" ToolTip="贴到屏幕 · 点击选中，Esc 移除" Click="PinClick"><Path Style="{StaticResource ToolIcon}" Data="M9,1 L17,9 M11,3 L6,8 3,8 10,15 10,12 15,7 M7,12 L2,17" /></Button>
      <Button x:Name="SaveCaptureButton" Style="{StaticResource CaptureButton}" ToolTip="保存 PNG 文件 (Ctrl+S)" Click="SaveClick"><Path Style="{StaticResource ToolIcon}" Data="M3,2 L13,2 16,5 16,16 3,16 Z M6,2 L6,7 12,7 12,2 M6,16 L6,11 13,11 13,16" /></Button>
      <Button x:Name="CopyCaptureButton" Style="{StaticResource CaptureButton}" ToolTip="复制并收纳 (Ctrl+C)" Click="CopyClick"><Path Style="{StaticResource ToolIcon}" Data="M6,6 L16,6 16,16 6,16 Z M3,12 L2,12 2,2 12,2 12,3" /></Button>
      <Button x:Name="CancelCaptureButton" Style="{StaticResource CaptureButton}" ToolTip="取消截图 (Esc / 鼠标右键)" Click="CancelClick"><Path Style="{StaticResource ToolIcon}" Data="M3,3 L15,15 M15,3 L3,15" /></Button>
      <Button x:Name="FinishCaptureButton" Style="{StaticResource CaptureButton}" Width="66" Background="#E5EEFF" Foreground="{StaticResource Accent}" ToolTip="完成并收纳 (Enter)" Click="CompleteClick"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolIcon}" Stroke="{StaticResource Accent}" Width="14" Data="M2,9 L7,14 16,4" /><TextBlock Text="完成" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
     </StackPanel>
     <StackPanel x:Name="AnnotationOptions" Orientation="Horizontal" Margin="4,5,4,1" Visibility="Collapsed">
      <TextBlock Text="颜色" Foreground="#62728D" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
      <Button Style="{StaticResource ColorButton}" Tag="#FFFF4D4F" ToolTip="红色" Click="ColorClick"><Ellipse Width="14" Height="14" Fill="#FF4D4F" /></Button>
      <Button Style="{StaticResource ColorButton}" Tag="#FF2488FF" ToolTip="蓝色" Click="ColorClick"><Ellipse Width="14" Height="14" Fill="#2488FF" /></Button>
      <Button Style="{StaticResource ColorButton}" Tag="#FF29B36B" ToolTip="绿色" Click="ColorClick"><Ellipse Width="14" Height="14" Fill="#29B36B" /></Button>
      <Button Style="{StaticResource ColorButton}" Tag="#FFFFCA28" ToolTip="黄色" Click="ColorClick"><Ellipse Width="14" Height="14" Fill="#FFCA28" /></Button>
      <Button Style="{StaticResource ColorButton}" Tag="#FFFFFFFF" ToolTip="白色" Click="ColorClick"><Ellipse Width="14" Height="14" Fill="White" Stroke="#ADB6C4" /></Button>
      <Button Style="{StaticResource ColorButton}" Tag="#FF202735" ToolTip="深色" Click="ColorClick"><Ellipse Width="14" Height="14" Fill="#202735" /></Button>
      <Border Width="14" />
      <TextBlock Text="线宽" Foreground="#62728D" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox x:Name="StrokeWidthBox" Width="50" Height="24" SelectedIndex="2" SelectionChanged="StyleChanged" DropDownClosed="StylePickerClosed"><ComboBoxItem Content="2" /><ComboBoxItem Content="3" /><ComboBoxItem Content="5" /><ComboBoxItem Content="8" /></ComboBox>
      <StackPanel x:Name="FontSizeOptions" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed"><TextBlock Text="字号" Foreground="#62728D" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" /><ComboBox x:Name="FontSizeBox" Width="55" Height="24" SelectedIndex="1" SelectionChanged="StyleChanged" DropDownClosed="StylePickerClosed"><ComboBoxItem Content="16" /><ComboBoxItem Content="20" /><ComboBoxItem Content="24" /><ComboBoxItem Content="32" /></ComboBox></StackPanel>
     </StackPanel>
     <StackPanel x:Name="ArrowStyleOptions" Orientation="Horizontal" Margin="4,5,4,1" Visibility="Collapsed">
      <TextBlock Text="样式" Foreground="#62728D" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
      <Button x:Name="ArrowLineStyleButton" Style="{StaticResource CaptureButton}" Width="78" Height="30" Tag="{x:Static models:ArrowStyle.Line}" ToolTip="细线箭头" Click="ArrowStyleClick"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolIcon}" Width="24" Height="16" Data="M2,9 L22,9 M16,3 L22,9 16,15" /><TextBlock Text="细线" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
      <Button x:Name="ArrowSolidStyleButton" Style="{StaticResource CaptureButton}" Width="78" Height="30" Tag="{x:Static models:ArrowStyle.Solid}" ToolTip="实心箭头" Click="ArrowStyleClick"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolIcon}" Width="24" Height="16" Fill="#254B7A" Data="M2,8 L15,8 15,3 23,9 15,15 15,10 2,10 Z" /><TextBlock Text="实心" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
      <Button x:Name="ArrowTaperedStyleButton" Style="{StaticResource CaptureButton}" Width="78" Height="30" Tag="{x:Static models:ArrowStyle.Tapered}" ToolTip="渐尖箭头：尖细尾部、实心箭头" Click="ArrowStyleClick"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolIcon}" Width="24" Height="16" Fill="#254B7A" StrokeThickness="0" Data="M1,9 L15,6 15,2 24,9 15,16 15,12 Z" /><TextBlock Text="渐尖" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
      <Button x:Name="ArrowOutlineStyleButton" Style="{StaticResource CaptureButton}" Width="78" Height="30" Tag="{x:Static models:ArrowStyle.Outline}" ToolTip="渐尖空心箭头：细尾逐渐变宽，仅绘制轮廓" Click="ArrowStyleClick"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolIcon}" Width="24" Height="16" Data="M1,9 L15,6 15,2 24,9 15,16 15,12 Z" /><TextBlock Text="空心" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
      <Button x:Name="ArrowPolylineStyleButton" Style="{StaticResource CaptureButton}" Width="78" Height="30" Tag="{x:Static models:ArrowStyle.Polyline}" ToolTip="折线箭头：按住鼠标沿路线拖动" Click="ArrowStyleClick"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolIcon}" Width="24" Height="16" Data="M2,14 L9,14 9,4 23,4 M18,0 L23,4 18,8" /><TextBlock Text="折线" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
     </StackPanel>
     <StackPanel x:Name="MosaicOptions" Orientation="Horizontal" Margin="4,5,4,1" Visibility="Collapsed">
      <TextBlock Text="颗粒大小" Foreground="#62728D" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox x:Name="MosaicSizeBox" Width="60" Height="24" SelectedIndex="1" SelectionChanged="StyleChanged" DropDownClosed="StylePickerClosed"><ComboBoxItem Content="8" /><ComboBoxItem Content="16" /><ComboBoxItem Content="24" /><ComboBoxItem Content="32" /></ComboBox>
     </StackPanel>
     <TextBlock x:Name="CaptureStatus" Foreground="#B64736" FontSize="11" MaxWidth="490" TextWrapping="Wrap" Margin="5,5,5,0" Visibility="Collapsed" />
    </StackPanel>
   </Border>
   <Grid x:Name="TextEditorHost" Visibility="{Binding Visibility, ElementName=AnnotationTextBox}">
    <TextBox x:Name="AnnotationTextBox" Style="{x:Null}" Visibility="Collapsed" MinHeight="38" Padding="4" FontSize="20" FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#FF4D4F" Background="Transparent" BorderBrush="{StaticResource SelectionOutline}" BorderThickness="2" AcceptsReturn="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" TextChanged="TextEditorChanged" PreviewKeyDown="TextEditorKeyDown" ToolTip="拖动边框移动文字 · Enter 确认 · Shift+Enter 换行 · Esc 放弃本次文字编辑 · 右键取消截图" />
    <Thumb x:Name="TextMoveTop" Style="{StaticResource TextMoveHandle}" Height="6" VerticalAlignment="Top" Margin="6,0,6,0" />
    <Thumb x:Name="TextMoveBottom" Style="{StaticResource TextMoveHandle}" Height="6" VerticalAlignment="Bottom" Margin="6,0,6,0" />
    <Thumb x:Name="TextMoveLeft" Style="{StaticResource TextMoveHandle}" Width="6" HorizontalAlignment="Left" />
    <Thumb x:Name="TextMoveRight" Style="{StaticResource TextMoveHandle}" Width="6" HorizontalAlignment="Right" />
   </Grid>
  </Canvas>
 </Grid>
</Window>
